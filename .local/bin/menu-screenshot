#!/bin/sh
# Screenshot of a region, the focused window or all outputs: a menu from the
# system menu (MOD+s), or straight to region selection with `region` (MOD+SHIFT+s).
# Copies it to the clipboard and saves /tmp/screenshots/YYYY-MM-DD_HH-MM-SS.png.
# DWL_FOCUSED_GEOM is set by dwl when it spawns the menu (focusgeom patch).

dir=/tmp/screenshots
fail() { notify-send -u critical "Screenshot" "$*"; exit 1; }

if [ "${1:-}" = region ]; then
	choice=Region
else
	choice=$(printf '%s\n' "󰩭  Region" "󰖯  Window" "󰍹  Full screen" |
		bemenu --vim-normal-mode -p "screenshot ") || exit 0
fi

case $choice in
*Region) geom=$(slurp -d) || exit 0 ;;
*Window) geom=${DWL_FOCUSED_GEOM:-}
	[ -n "$geom" ] || fail "No focused window" ;;
*Full*)  geom= ;;
*) exit 0 ;;
esac

mkdir -p "$dir" || fail "cannot create $dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
sleep 0.2   # let the menu disappear from the screen first
if [ -n "$geom" ]; then
	grim -g "$geom" "$file" || fail "grim failed"
else
	grim "$file" || fail "grim failed"
fi
wl-copy --type image/png < "$file" || fail "copy to clipboard failed"
notify-send -i "$file" "Screenshot" "Copied, saved to $file"
