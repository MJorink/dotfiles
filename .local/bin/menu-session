#!/bin/sh
# MOD+p: session menu. Reboot, power off and suspend use doas rules without a
# password (NixOS: systemctl reboot/poweroff/suspend; Alpine: /sbin/reboot,
# /sbin/poweroff). "Pause idle" stops the auto-lock and screen-off (swayidle).

power() {
	if command -v systemctl >/dev/null; then exec doas -n systemctl "$1"; fi
	exec doas -n "/sbin/$1"
}

if idle status; then idle_item="󰅶  Pause idle"; else idle_item="󰾪  Resume idle"; fi

choice=$(printf '%s\n' "  Lock" "$idle_item" "󰤄  Suspend" "󰍃  Log out" "󰜉  Reboot" "󰐥  Power off" |
	bemenu --vim-normal-mode -p "session ") || exit 0

case $choice in
*Lock)    exec lock ;;
*idle)    exec idle toggle ;;
*Suspend) exec lock-suspend ;;
*Log*)    exec pkill -TERM -x -u "$(id -u)" dwl ;;
*Reboot)  power reboot ;;
*Power*)  power poweroff ;;
esac
