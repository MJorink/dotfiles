#!/bin/sh
# MOD+p: session menu. Reboot, power off and suspend use doas rules without a
# password (systemctl reboot/poweroff/suspend). "Pause idle" stops the
# auto-lock and screen-off (swayidle).

if idle status; then idle_item="󰅶  Pause idle"; else idle_item="󰾪  Resume idle"; fi

pkill -x bemenu # one menu at a time: close any other
choice=$(printf '%s\n' "󰌾  Lock" "$idle_item" "󰤄  Suspend" "󰍃  Log out" "󰜉  Reboot" "󰐥  Power off" |
	bemenu --vim-normal-mode -p "Lock, Suspend, Log Out, Power Off") || exit 0

case $choice in
*Lock)    exec lock ;;
*idle)    exec idle toggle ;;
*Suspend) exec lock-suspend ;;
*Log*)    exec pkill -TERM -x -u "$(id -u)" glasswm ;;
*Reboot)  exec doas -n systemctl reboot ;;
*Power*)  exec doas -n systemctl poweroff ;;
esac
